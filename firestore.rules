rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validVisitorId(visitorId) {
      return visitorId is string
        && visitorId.matches('^[a-z0-9]{16,40}$');
    }

    function validUserId(userId) {
      return userId is string && userId.size() <= 128;
    }

    function validAnalyticsIdentity(data) {
      return validUserId(data.userId)
        && data.authState in ['anonymous', 'signed_in']
        && (
          (data.authState == 'anonymous' && data.userId == '')
          || (data.authState == 'signed_in'
            && request.auth != null
            && data.userId == request.auth.uid)
        );
    }

    function validAnalyticsSlug(slug) {
      return slug is string && slug.matches('^(home|[a-z0-9-]{1,64})$');
    }

    function validDate(date) {
      return date is string && date.matches('^[0-9]{8}$');
    }

    function nonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function validDailyReport(data, date) {
      return validDate(date)
        && data.keys().hasOnly([
          'date',
          'sessions',
          'homeSessions',
          'gameSessions',
          'visitorUu',
          'loginUu',
          'searches',
          'completedGames',
          'leftGames',
          'gameDurationSec',
          'lastUpdatedAt'
        ])
        && data.date == date
        && nonNegativeInt(data.sessions)
        && nonNegativeInt(data.homeSessions)
        && nonNegativeInt(data.gameSessions)
        && nonNegativeInt(data.visitorUu)
        && nonNegativeInt(data.loginUu)
        && nonNegativeInt(data.searches)
        && nonNegativeInt(data.completedGames)
        && nonNegativeInt(data.leftGames)
        && nonNegativeInt(data.gameDurationSec)
        && data.lastUpdatedAt == request.time;
    }

    function validNeedLabel(need, label) {
      return (need == 'meeting' && label == '会議')
        || (need == 'tired' && label == '疲れ')
        || (need == 'procrastination' && label == '先延ばし')
        || (need == 'relationships' && label == '人間関係')
        || (need == 'refusal' && label == '断れない')
        || (need == 'work' && label == '仕事')
        || (need == 'anxiety' && label == '不安')
        || (need == 'sleep' && label == '睡眠')
        || (need == 'comparison' && label == '比較')
        || (need == 'depressed' && label == '落ち込み')
        || (need == 'anger' && label == '怒り')
        || (need == 'overwhelm' && label == '圧倒')
        || (need == 'motivation' && label == '行動')
        || (need == 'self' && label == '自分');
    }

    match /levelupUsers/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      match /history/{gameId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Aggregate app-open counts. Public read is used only to rank the "人気" section.
    // Writes are append-like counters only: clients cannot lower counts or add fields.
    match /levelupAppStats/{gameId} {
      allow read: if true;
      allow create: if gameId.matches('^[a-z0-9-]{1,64}$')
        && request.resource.data.keys().hasOnly(['opens', 'lastOpenAt'])
        && request.resource.data.opens is int
        && request.resource.data.opens == 1
        && request.resource.data.lastOpenAt == request.time;
      allow update: if gameId.matches('^[a-z0-9-]{1,64}$')
        && request.resource.data.keys().hasOnly(['opens', 'lastOpenAt'])
        && request.resource.data.opens is int
        && request.resource.data.opens == resource.data.opens + 1
        && request.resource.data.lastOpenAt == request.time;
      allow delete: if false;
    }

    // Search phrases stay private. Automated reports expose only fixed need categories.
    match /levelupSearchStats/{termId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['term', 'count', 'lastSearchedAt'])
        && request.resource.data.term is string
        && request.resource.data.term.size() >= 2
        && request.resource.data.term.size() <= 40
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && request.resource.data.lastSearchedAt == request.time;
      allow update: if request.resource.data.keys().hasOnly(['term', 'count', 'lastSearchedAt'])
        && request.resource.data.term == resource.data.term
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastSearchedAt == request.time;
      allow delete: if false;
    }

    // Stable, privacy-preserving browser visitor records.
    match /levelupVisitors/{visitorId} {
      allow read, delete: if false;
      allow create: if validVisitorId(visitorId)
        && request.resource.data.keys().hasOnly(['visitorId', 'userId', 'authState', 'lastSlug', 'sessionCount', 'lastSeenAt'])
        && request.resource.data.visitorId == visitorId
        && validAnalyticsIdentity(request.resource.data)
        && validAnalyticsSlug(request.resource.data.lastSlug)
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount == 1
        && request.resource.data.lastSeenAt == request.time;
      allow update: if validVisitorId(visitorId)
        && request.resource.data.keys().hasOnly(['visitorId', 'userId', 'authState', 'lastSlug', 'sessionCount', 'lastSeenAt'])
        && request.resource.data.visitorId == resource.data.visitorId
        && request.resource.data.visitorId == visitorId
        && validAnalyticsIdentity(request.resource.data)
        && validAnalyticsSlug(request.resource.data.lastSlug)
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount in [resource.data.sessionCount, resource.data.sessionCount + 1]
        && request.resource.data.lastSeenAt == request.time;
    }

    // One document per browser visitor per Japan-calendar day.
    match /levelupVisitorDays/{date}/visitors/{visitorId} {
      allow read, delete: if false;
      allow create: if validDate(date)
        && validVisitorId(visitorId)
        && request.resource.data.keys().hasOnly(['date', 'visitorId', 'userId', 'authState', 'lastSlug', 'sessionCount', 'lastSeenAt'])
        && request.resource.data.date == date
        && request.resource.data.visitorId == visitorId
        && validAnalyticsIdentity(request.resource.data)
        && validAnalyticsSlug(request.resource.data.lastSlug)
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount == 1
        && request.resource.data.lastSeenAt == request.time;
      allow update: if validDate(date)
        && validVisitorId(visitorId)
        && request.resource.data.keys().hasOnly(['date', 'visitorId', 'userId', 'authState', 'lastSlug', 'sessionCount', 'lastSeenAt'])
        && request.resource.data.date == resource.data.date
        && request.resource.data.date == date
        && request.resource.data.visitorId == resource.data.visitorId
        && request.resource.data.visitorId == visitorId
        && validAnalyticsIdentity(request.resource.data)
        && validAnalyticsSlug(request.resource.data.lastSlug)
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount in [resource.data.sessionCount, resource.data.sessionCount + 1]
        && request.resource.data.lastSeenAt == request.time;
    }

    // One aggregate record per authenticated user.
    match /levelupLoginUsers/{userId} {
      allow read, delete: if false;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId', 'lastSlug', 'sessionCount', 'lastSeenAt'])
        && request.resource.data.userId == userId
        && validAnalyticsSlug(request.resource.data.lastSlug)
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount == 1
        && request.resource.data.lastSeenAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId', 'lastSlug', 'sessionCount', 'lastSeenAt'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == userId
        && validAnalyticsSlug(request.resource.data.lastSlug)
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount in [resource.data.sessionCount, resource.data.sessionCount + 1]
        && request.resource.data.lastSeenAt == request.time;
    }

    // One document per authenticated user per Japan-calendar day = signed-in DAU.
    match /levelupLoginDays/{date}/users/{userId} {
      allow read, delete: if false;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && validDate(date)
        && request.resource.data.keys().hasOnly(['date', 'userId', 'lastSlug', 'sessionCount', 'lastSeenAt'])
        && request.resource.data.date == date
        && request.resource.data.userId == userId
        && validAnalyticsSlug(request.resource.data.lastSlug)
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount == 1
        && request.resource.data.lastSeenAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && validDate(date)
        && request.resource.data.keys().hasOnly(['date', 'userId', 'lastSlug', 'sessionCount', 'lastSeenAt'])
        && request.resource.data.date == resource.data.date
        && request.resource.data.date == date
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == userId
        && validAnalyticsSlug(request.resource.data.lastSlug)
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount in [resource.data.sessionCount, resource.data.sessionCount + 1]
        && request.resource.data.lastSeenAt == request.time;
    }

    // Private exact marker for one authenticated user per report day.
    // It is readable only by that user so the client can transactionally increment loginUu once.
    match /levelupReportLoginDays/{date}/users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && validDate(date)
        && request.resource.data.keys().hasOnly(['date', 'userId', 'createdAt'])
        && request.resource.data.date == date
        && request.resource.data.userId == userId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Sanitized daily report. Public read is intentionally limited to aggregate counters.
    // No UID, raw search phrase, profile field, or visitor ID is stored here.
    match /levelupDailyReports/{date} {
      allow read: if true;
      allow create: if validDailyReport(request.resource.data, date)
        && request.resource.data.sessions <= 1
        && request.resource.data.homeSessions <= 1
        && request.resource.data.gameSessions <= 1
        && request.resource.data.visitorUu <= 1
        && request.resource.data.loginUu <= 1
        && request.resource.data.searches <= 1
        && request.resource.data.completedGames <= 1
        && request.resource.data.leftGames <= 1
        && request.resource.data.gameDurationSec <= 86400;
      allow update: if validDailyReport(request.resource.data, date)
        && request.resource.data.date == resource.data.date
        && request.resource.data.sessions in [resource.data.sessions, resource.data.sessions + 1]
        && request.resource.data.homeSessions in [resource.data.homeSessions, resource.data.homeSessions + 1]
        && request.resource.data.gameSessions in [resource.data.gameSessions, resource.data.gameSessions + 1]
        && request.resource.data.visitorUu in [resource.data.visitorUu, resource.data.visitorUu + 1]
        && request.resource.data.loginUu in [resource.data.loginUu, resource.data.loginUu + 1]
        && request.resource.data.searches in [resource.data.searches, resource.data.searches + 1]
        && request.resource.data.completedGames in [resource.data.completedGames, resource.data.completedGames + 1]
        && request.resource.data.leftGames in [resource.data.leftGames, resource.data.leftGames + 1]
        && request.resource.data.gameDurationSec >= resource.data.gameDurationSec
        && request.resource.data.gameDurationSec <= resource.data.gameDurationSec + 86400;
      allow delete: if false;

      match /games/{gameId} {
        allow read: if true;
        allow create: if validDate(date)
          && gameId.matches('^[a-z0-9-]{1,64}$')
          && request.resource.data.keys().hasOnly(['date', 'slug', 'title', 'sessions', 'completed', 'left', 'durationSec', 'lastUpdatedAt'])
          && request.resource.data.date == date
          && request.resource.data.slug == gameId
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 80
          && nonNegativeInt(request.resource.data.sessions)
          && request.resource.data.sessions <= 1
          && nonNegativeInt(request.resource.data.completed)
          && request.resource.data.completed <= 1
          && nonNegativeInt(request.resource.data.left)
          && request.resource.data.left <= 1
          && nonNegativeInt(request.resource.data.durationSec)
          && request.resource.data.durationSec <= 86400
          && request.resource.data.lastUpdatedAt == request.time;
        allow update: if request.resource.data.keys().hasOnly(['date', 'slug', 'title', 'sessions', 'completed', 'left', 'durationSec', 'lastUpdatedAt'])
          && request.resource.data.date == resource.data.date
          && request.resource.data.date == date
          && request.resource.data.slug == resource.data.slug
          && request.resource.data.slug == gameId
          && request.resource.data.title == resource.data.title
          && request.resource.data.sessions in [resource.data.sessions, resource.data.sessions + 1]
          && request.resource.data.completed in [resource.data.completed, resource.data.completed + 1]
          && request.resource.data.left in [resource.data.left, resource.data.left + 1]
          && request.resource.data.durationSec >= resource.data.durationSec
          && request.resource.data.durationSec <= resource.data.durationSec + 86400
          && request.resource.data.lastUpdatedAt == request.time;
        allow delete: if false;
      }

      match /needs/{need} {
        allow read: if true;
        allow create: if validDate(date)
          && request.resource.data.keys().hasOnly(['date', 'need', 'label', 'count', 'lastUpdatedAt'])
          && request.resource.data.date == date
          && request.resource.data.need == need
          && validNeedLabel(need, request.resource.data.label)
          && request.resource.data.count is int
          && request.resource.data.count == 1
          && request.resource.data.lastUpdatedAt == request.time;
        allow update: if request.resource.data.keys().hasOnly(['date', 'need', 'label', 'count', 'lastUpdatedAt'])
          && request.resource.data.date == resource.data.date
          && request.resource.data.date == date
          && request.resource.data.need == resource.data.need
          && request.resource.data.need == need
          && request.resource.data.label == resource.data.label
          && validNeedLabel(need, request.resource.data.label)
          && request.resource.data.count is int
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.lastUpdatedAt == request.time;
        allow delete: if false;
      }
    }

    // One opaque document per LEVEL UP page/game session.
    match /levelupSessions/{sessionId} {
      allow read, delete: if false;
      allow create: if sessionId.matches('^[a-z0-9]{8,40}$')
        && request.resource.data.keys().hasOnly(['slug', 'buildSha', 'status', 'lastStep', 'lastAction', 'startedAt', 'lastSeenAt', 'visitorId', 'userId', 'authState', 'pageKind', 'durationSec'])
        && validAnalyticsSlug(request.resource.data.slug)
        && request.resource.data.buildSha is string
        && request.resource.data.buildSha.size() >= 4
        && request.resource.data.buildSha.size() <= 12
        && request.resource.data.status == 'active'
        && request.resource.data.lastStep is string
        && request.resource.data.lastStep.size() <= 60
        && request.resource.data.lastAction is string
        && request.resource.data.lastAction.size() <= 80
        && request.resource.data.startedAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && (!('visitorId' in request.resource.data) || validVisitorId(request.resource.data.visitorId))
        && (!('userId' in request.resource.data) || validAnalyticsIdentity(request.resource.data))
        && (!('pageKind' in request.resource.data) || request.resource.data.pageKind in ['home', 'game'])
        && (!('durationSec' in request.resource.data) || (request.resource.data.durationSec is int && request.resource.data.durationSec >= 0 && request.resource.data.durationSec <= 86400));
      allow update: if request.resource.data.keys().hasOnly(['slug', 'buildSha', 'status', 'lastStep', 'lastAction', 'startedAt', 'lastSeenAt', 'visitorId', 'userId', 'authState', 'pageKind', 'durationSec'])
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.buildSha == resource.data.buildSha
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.status in ['active', 'left', 'completed']
        && request.resource.data.lastStep is string
        && request.resource.data.lastStep.size() <= 60
        && request.resource.data.lastAction is string
        && request.resource.data.lastAction.size() <= 80
        && request.resource.data.lastSeenAt == request.time
        && (!('visitorId' in request.resource.data) || validVisitorId(request.resource.data.visitorId))
        && (!('visitorId' in resource.data) || request.resource.data.visitorId == resource.data.visitorId)
        && (!('userId' in request.resource.data) || validAnalyticsIdentity(request.resource.data))
        && (!('pageKind' in request.resource.data) || request.resource.data.pageKind in ['home', 'game'])
        && (!('pageKind' in resource.data) || request.resource.data.pageKind == resource.data.pageKind)
        && (!('durationSec' in request.resource.data) || (request.resource.data.durationSec is int && request.resource.data.durationSec >= 0 && request.resource.data.durationSec <= 86400));
    }
  }
}
