rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /levelupUsers/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      match /history/{gameId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Aggregate app-open counts. Public read is used only to rank the "人気" section.
    // Writes are append-like counters only: clients cannot lower counts or add fields.
    match /levelupAppStats/{gameId} {
      allow read: if true;
      allow create: if gameId.matches('^[a-z0-9-]{1,64}$')
        && request.resource.data.keys().hasOnly(['opens', 'lastOpenAt'])
        && request.resource.data.opens is int
        && request.resource.data.opens == 1
        && request.resource.data.lastOpenAt == request.time;
      allow update: if gameId.matches('^[a-z0-9-]{1,64}$')
        && request.resource.data.keys().hasOnly(['opens', 'lastOpenAt'])
        && request.resource.data.opens is int
        && request.resource.data.opens == resource.data.opens + 1
        && request.resource.data.lastOpenAt == request.time;
      allow delete: if false;
    }

    // Search phrases are write-only for visitors and readable only to signed-in users.
    // Obvious email/URL/long-number patterns are filtered in the client before writing.
    match /levelupSearchStats/{termId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly(['term', 'count', 'lastSearchedAt'])
        && request.resource.data.term is string
        && request.resource.data.term.size() >= 2
        && request.resource.data.term.size() <= 40
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && request.resource.data.lastSearchedAt == request.time;
      allow update: if request.resource.data.keys().hasOnly(['term', 'count', 'lastSearchedAt'])
        && request.resource.data.term == resource.data.term
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastSearchedAt == request.time;
      allow delete: if false;
    }
  }
}
