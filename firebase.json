{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".dist/firebase",
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/start",
        "destination": "https://hitobito-tools.vercel.app/start",
        "type": 302
      },
      {
        "source": "/maa-iika",
        "destination": "https://hitobito-tools.vercel.app/maa-iika",
        "type": 302
      },
      {
        "source": "/self-management",
        "destination": "https://hitobito-tools.vercel.app/self-management",
        "type": 302
      }
    ]
  }
}
