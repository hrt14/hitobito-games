{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "404.hitobito.jp" }],
      "destination": "/kaiki/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "404.hitobito.jp" }],
      "destination": "/kaiki/:path*"
    }
  ]
}
