rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid}/appState/{docId} {
      allow read, write: if self(uid) && docId == "habit_planet";
    }
    match /entitlements/{uid} {
      allow read: if self(uid);
      allow write: if false;
    }
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
